---
import defaultThemeUrl from "../styles/global.css?url";
import cheetahThemeUrl from "../styles/cheetah.css?url";
import darkThemeUrl from "../styles/dark.css?url";

const projects = [
  {
    name: "Yaup",
    year: "2026",
    label: "AI agent governance tooling",
    href: "https://github.com/erme2/Yaup",
    body:
      "Public workflow tooling that applies one versioned policy and a mechanically enforced planning gate across Codex, Claude Code, Cursor, Copilot, and Gemini CLI."
  },
  {
    name: "Pane",
    year: "2026",
    label: "Data-access control plane",
    href: "https://github.com/erme2/Pane",
    body:
      "A source-available Laravel control plane for authentication, organisation isolation, encrypted database connections, catalog discovery, and controlled CRUD."
  },
  {
    name: "Latte",
    year: "2026",
    label: "Frontend template",
    href: "https://github.com/erme2/Latte",
    body:
      "A source-available React and TypeScript template for organisation-specific applications powered by Pane, shared authentication, and Docker-based local development."
  },
  {
    name: "erme2.com",
    year: "2026",
    label: "Open personal site",
    href: "https://github.com/erme2/erme2.com",
    body:
      "This website: a public Astro project used as a small but visible proof of an AI-assisted engineering workflow, from issue to review to deployment."
  }
];

const workflowLinks = [
  {
    label: "Coordination board",
    href: "https://github.com/users/erme2/projects/7/views/1"
  },
  {
    label: "Yaup",
    href: "https://github.com/erme2/Yaup"
  },
  {
    label: "Pane",
    href: "https://github.com/erme2/Pane"
  },
  {
    label: "Latte",
    href: "https://github.com/erme2/Latte"
  },
  {
    label: "erme2.com",
    href: "https://github.com/erme2/erme2.com"
  },
  {
    label: "Hostinger",
    href: "https://www.hostinger.com"
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Arduino Di Giosia is a tech lead, senior TypeScript and PHP engineer, and engineering leader based in Nottingham."
    />
    <link id="theme-stylesheet" rel="stylesheet" href={defaultThemeUrl} />
    <title>Arduino Di Giosia | Tech Lead & Senior Engineer</title>
    <script is:inline define:vars={{ cheetahThemeUrl, darkThemeUrl }}>
      const params = new URLSearchParams(window.location.search);
      const stylesheet = document.getElementById("theme-stylesheet");
      if (params.get("theme") === "cheetah") {
        stylesheet?.setAttribute("href", cheetahThemeUrl);
      } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        stylesheet?.setAttribute("href", darkThemeUrl);
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <nav class="site-shell nav" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Arduino Di Giosia home">
          <img class="mark" src="/images/arduino-di-giosia.png" alt="" aria-hidden="true" />
          <span>
            <strong>Arduino Di Giosia</strong>
            <span>Tech Lead · Senior Engineer</span>
          </span>
        </a>
        <div class="nav-links">
          <a href="#profile">Profile</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#workflow">Workflow</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main id="top">
      <div class="site-shell hero">
        <div>
          <p class="eyebrow">Tech Lead · Senior TypeScript/PHP</p>
          <h1>Hands-on engineering leadership.</h1>
          <p class="lead">
            I build and modernise web platforms, APIs, payment systems, and business-critical tooling:
            close to the code, credible with engineers, effective with product and leadership, and comfortable
            managing teams.
          </p>
          <div class="cta-row" aria-label="Contact and profile links">
            <a class="button" href="mailto:me@erme2.com">
              <span class="contact-icon" aria-hidden="true">@</span>
              <span>Email me</span>
            </a>
            <a class="button secondary" href="https://github.com/erme2" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">GH</span>
              <span>GitHub</span>
            </a>
            <a class="button secondary" href="https://linkedin.com/in/arduinodigiosia" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">in</span>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <aside class="signal-board" aria-label="Career highlights">
          <div class="board-top">
            <span>Current signal</span>
            <span class="status-dot" aria-hidden="true"></span>
          </div>
          <div class="metrics">
            <div class="metric">
              <strong>20+</strong>
              <span>years building web platforms, APIs, payments, and business tooling</span>
            </div>
            <div class="metric">
              <strong>10-12</strong>
              <span>engineers led across four remote teams and four time zones</span>
            </div>
            <div class="metric">
              <strong>5-10M</strong>
              <span>weekly clicks handled by affiliate tracking platforms</span>
            </div>
            <div class="metric">
              <strong>10 min</strong>
              <span>
                built in 10 minutes with an AI-assisted engineering workflow.
                <a href="https://github.com/erme2/erme2.com" target="_blank" rel="noopener noreferrer">View repository</a>
              </span>
            </div>
          </div>
          <p class="positioning">
            <strong>Positioning:</strong> tech lead, senior TypeScript and PHP engineer, and engineering
            leader with devops architecture experience and the ability to build multi-region platforms.
          </p>
        </aside>
      </div>

      <section id="profile">
        <div class="site-shell">
          <div class="section-title">
            <h2>Engineer first. Manager when it matters.</h2>
            <p>
              My strongest roles sit between individual contribution and engineering management. I can design
              and build systems myself, but I can also stabilise teams, make delivery predictable, mentor
              engineers, and communicate clearly with product, finance, and executive stakeholders. I treat
              languages and frameworks as tools: PHP is a long-standing strength, Node and React became core
              skills in recent years, and I adapt the stack to the problem instead of forcing every problem
              through the same tool.
            </p>
          </div>

          <div class="pill-grid">
            <div class="pill">
              <strong>Modern product engineering</strong>
              <span>TypeScript, PHP, React, REST APIs, payments, subscriptions, and integrations.</span>
            </div>
            <div class="pill">
              <strong>Flexible technical judgment</strong>
              <span>Choosing the right tool for the job, learning quickly when the needs change, and avoiding one-size-fits-all engineering.</span>
            </div>
            <div class="pill">
              <strong>Leadership with code credibility</strong>
              <span>Team structure, mentoring, hiring, delivery planning, one-to-ones, and technical direction.</span>
            </div>
            <div class="pill">
              <strong>Operational discipline</strong>
              <span>CI/CD, testing strategy, regulated change control, production support, Docker, Kubernetes, AWS, and multi-region architecture.</span>
            </div>
            <div class="pill">
              <strong>Priority focus</strong>
              <span>Keeping teams focused on the main constraints so the best working product gets shipped in the shortest practical time.</span>
            </div>
          </div>
        </div>
      </section>

      <section id="experience">
        <div class="site-shell">
          <div class="section-title">
            <h2>Recent work</h2>
            <p>
              A mix of hands-on software engineering, leadership in remote teams, platform modernisation, and
              production-grade delivery in commercial and regulated environments.
            </p>
          </div>

          <div class="timeline">
            <article class="role">
              <div>
                <h3>VP of Engineering · ClickTech</h3>
                <p class="role-meta">Nottingham, remote · Nov 2025 - Aug 2026</p>
              </div>
              <ul>
                <li>Led four remote teams while staying close to architecture and implementation.</li>
                <li>Rebuilt a central NestJS payments and subscriptions API with unified webhooks, endpoints, and a shared client library.</li>
                <li>Eliminated production outages within roughly three weeks, then removed release regressions through end-to-end testing and team training.</li>
                <li>Standardised AI-assisted development with guardrails, templates, review gates, and internal engineering standards.</li>
              </ul>
            </article>

            <article class="role">
              <div>
                <h3>Engineer III · AJ Bell</h3>
                <p class="role-meta">Manchester · Mar 2023 - Oct 2025</p>
              </div>
              <ul>
                <li>Developed customer-facing investment platform services across frontend and backend systems.</li>
                <li>Built and improved REST APIs, third-party integrations, and supporting services with reliability and maintainability in focus.</li>
                <li>Worked in a security- and stability-first financial services culture with rigorous review, testing, and change control.</li>
              </ul>
            </article>

            <article class="role">
              <div>
                <h3>Head of Development · Moreniche</h3>
                <p class="role-meta">Nottingham · Mar 2017 - Mar 2023</p>
              </div>
              <ul>
                <li>Set technical direction for affiliate interfaces, REST/API platforms, tracking servers, shops, devops, and design teams.</li>
                <li>Scaled the tracking platform from about 1M to 5-10M clicks per week at marketing peak.</li>
                <li>Supported $2-5M/year in affiliate revenue while improving reliability and operational control.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section id="projects">
        <div class="site-shell">
          <div class="section-title">
            <h2>Personal projects</h2>
            <p>
              Current public repositories focus on AI-assisted delivery governance, controlled data access,
              reusable application foundations, and the public site itself. Yaup, Pane, Latte, and erme2.com
              are designed to work as a practical stack for safer agent-assisted software delivery.
            </p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project">
                  <div>
                    <p class="year">{project.year}</p>
                    <h3>{project.name}</h3>
                    <p><strong>{project.label}</strong></p>
                    <p>{project.body}</p>
                    <a class="project-link" href={project.href} target="_blank" rel="noopener noreferrer">View repository</a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="workflow">
        <div class="site-shell">
          <div class="section-title">
            <h2>Open AI-assisted engineering workflow</h2>
            <p>
              The work behind this CV is now visible in public repositories: the planning system, the control
              plane, the application template, the project board, the issues, this website, and the tool
              connectors used to operate them. The point is not that AI writes code on its own; it is that
              human judgment, small issues, review loops, MCP tools, and automated validation can be
              orchestrated into a repeatable delivery system.
            </p>
          </div>

          <div class="workflow-grid">
            <article class="workflow-card">
              <p class="year">1</p>
              <h3>Plan the work in public</h3>
              <p>
                Ideas become GitHub issues and project-board items. Each issue is small enough to review, link,
                test, and trace back to a concrete change.
              </p>
            </article>
            <article class="workflow-card">
              <p class="year">2</p>
              <h3>Use Yaup as the guardrail</h3>
              <p>
                Yaup coordinates agent work with shared rules, planning gates, validation commands, and review
                conventions across the repositories.
              </p>
            </article>
            <article class="workflow-card">
              <p class="year">3</p>
              <h3>Automate through MCP tools</h3>
              <p>
                Connected tools let the workflow operate GitHub, hosting, deployments, project metadata, and
                other services directly from the engineering conversation.
              </p>
            </article>
            <article class="workflow-card">
              <p class="year">4</p>
              <h3>Build reusable foundations</h3>
              <p>
                Pane provides the controlled data-access layer. Latte gives application teams a React and
                TypeScript starting point that plugs into that control plane.
              </p>
            </article>
            <article class="workflow-card">
              <p class="year">5</p>
              <h3>Publish the evidence</h3>
              <p>
                Pull requests, commits, and issues in the Pane, Latte, and Yaup repositories show the actual
                workflow: quick iteration, explicit review, passing validation, and open-source artefacts.
              </p>
            </article>
          </div>

          <div class="workflow-map">
            <div>
              <h3>One orchestrated product system</h3>
              <p>
                Pane and Latte are the more complex product work using this workflow: GitHub for issues and
                coordination, MCP tools for action, Hostinger for hosting operations, Yaup for governance, and
                Codex as the engineering partner inside the loop. erme2.com is different: it is a quick public
                site built in about 10 minutes from an updated CV, then used here to explain the system. More
                tools can be added the same way, exposing new services without changing the core workflow.
              </p>
            </div>
            <div class="workflow-links" aria-label="Workflow links">
              {
                workflowLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="skills">
        <div class="site-shell">
          <div class="section-title">
            <h2>Core skills</h2>
            <p>
              The technical base is broad, but the current focus is modern TypeScript product engineering,
              production reliability, and disciplined AI-assisted delivery.
            </p>
          </div>

          <div class="skills">
            <div class="skill-group">
              <h3>Backend</h3>
              <p>TypeScript, PHP, NestJS, Laravel, REST API design, payments, subscriptions, integrations, Symfony, Zend.</p>
            </div>
            <div class="skill-group">
              <h3>Frontend</h3>
              <p>React, Vue, TypeScript, JavaScript, and legacy-to-modern product migrations.</p>
            </div>
            <div class="skill-group">
              <h3>Cloud & infrastructure</h3>
              <p>AWS, EKS, Vercel, Railway, Docker, Kubernetes, Linux, Bash, SQL, NoSQL, and CI/CD.</p>
            </div>
            <div class="skill-group">
              <h3>Leadership</h3>
              <p>Technical direction, mentoring, hiring, stakeholder communication, delivery planning, priority focus, and AI workflow governance.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="site-shell contact-band">
          <div>
            <p class="eyebrow">Engineering Leadership · Delivery Discipline · AI-assisted Workflows</p>
            <h2>Engineering judgment, code credibility, and management experience in one place.</h2>
          </div>
          <div class="contact-links">
            <a href="mailto:me@erme2.com">
              <span class="contact-icon" aria-hidden="true">@</span>
              <span>me@erme2.com</span>
            </a>
            <a href="https://github.com/erme2" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">GH</span>
              <span>github.com/erme2</span>
            </a>
            <a href="https://linkedin.com/in/arduinodigiosia" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">in</span>
              <span>linkedin.com/in/arduinodigiosia</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-shell footer">
      <span>Arduino Di Giosia · Tech lead and senior engineer · TypeScript, React, PHP</span>
    </footer>
    <script is:inline>
      const navLinks = Array.from(document.querySelectorAll(".nav-links a[href^='#']"));
      const sections = navLinks
        .map((link) => {
          const target = document.querySelector(link.getAttribute("href"));

          return target ? { link, target } : null;
        })
        .filter(Boolean);

      const setActiveSection = (id) => {
        sections.forEach(({ link }) => {
          const isActive = link.getAttribute("href") === `#${id}`;
          link.classList.toggle("is-active", isActive);

          if (isActive) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const activeSectionFromScroll = () => {
        const offset = window.innerHeight * 0.32;
        const current = sections
          .map(({ target }) => ({
            id: target.id,
            top: target.getBoundingClientRect().top
          }))
          .filter((section) => section.top <= offset)
          .at(-1);

        if (current) {
          setActiveSection(current.id);
        }
      };

      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.getAttribute("href").slice(1);
          setActiveSection(id);
        });
      });

      activeSectionFromScroll();
      window.addEventListener("scroll", activeSectionFromScroll, { passive: true });
    </script>
  </body>
</html>
