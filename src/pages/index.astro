---
import defaultThemeUrl from "../styles/global.css?url";
import cheetahThemeUrl from "../styles/cheetah.css?url";
import fnThemeUrl from "../styles/fn.css?url";

const projects = [
  {
    name: "Yaup",
    year: "2026",
    label: "AI agent governance tooling",
    href: "https://github.com/erme2/Yaup",
    body:
      "Public workflow tooling that applies one versioned policy and a mechanically enforced planning gate across Codex, Claude Code, Cursor, Copilot, and Gemini CLI."
  },
  {
    name: "Pane",
    year: "2026",
    label: "Data-access control plane",
    href: "https://github.com/erme2/Pane",
    body:
      "A source-available Laravel control plane for authentication, organisation isolation, encrypted database connections, catalog discovery, and controlled CRUD."
  },
  {
    name: "Latte",
    year: "2026",
    label: "Frontend template",
    href: "https://github.com/erme2/Latte",
    body:
      "A source-available React and TypeScript template for organisation-specific applications powered by Pane, shared authentication, and Docker-based local development."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Arduino Di Giosia is a senior TypeScript and Node.js engineer, tech lead, and engineering leader based in Nottingham."
    />
    <link id="theme-stylesheet" rel="stylesheet" href={defaultThemeUrl} />
    <title>Arduino Di Giosia | Tech Lead & Senior Engineer</title>
    <script is:inline define:vars={{ cheetahThemeUrl, fnThemeUrl }}>
      const params = new URLSearchParams(window.location.search);
      const themes = {
        cheetah: cheetahThemeUrl,
        fn: fnThemeUrl
      };
      const selectedTheme = themes[params.get("theme")];
      if (selectedTheme) {
        document.getElementById("theme-stylesheet")?.setAttribute("href", selectedTheme);
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <nav class="site-shell nav" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Arduino Di Giosia home">
          <img class="mark" src="/images/arduino-di-giosia.png" alt="" aria-hidden="true" />
          <span>
            <strong>Arduino Di Giosia</strong>
            <span>Tech Lead · Senior Engineer</span>
          </span>
        </a>
        <div class="nav-links">
          <a href="#profile">Profile</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main id="top">
      <div class="site-shell hero">
        <div>
          <p class="eyebrow">Tech Lead · Senior TypeScript/PHP</p>
          <h1>Hands-on engineering leadership.</h1>
          <p class="lead">
            I build and modernise web platforms, APIs, payment systems, and business-critical tooling:
            close to the code, credible with engineers, effective with product and leadership, and comfortable
            managing teams.
          </p>
          <div class="cta-row" aria-label="Contact and profile links">
            <a class="button" href="mailto:me@erme2.com">
              <span class="contact-icon" aria-hidden="true">@</span>
              <span>Email me</span>
            </a>
            <a class="button secondary" href="https://github.com/erme2">
              <span class="contact-icon" aria-hidden="true">GH</span>
              <span>GitHub</span>
            </a>
            <a class="button secondary" href="https://linkedin.com/in/arduinodigiosia">
              <span class="contact-icon" aria-hidden="true">in</span>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <aside class="signal-board" aria-label="Career highlights">
          <div class="board-top">
            <span>Current signal</span>
            <span class="status-dot" aria-hidden="true"></span>
          </div>
          <div class="metrics">
            <div class="metric">
              <strong>20+</strong>
              <span>years building web platforms, APIs, payments, and business tooling</span>
            </div>
            <div class="metric">
              <strong>10-12</strong>
              <span>engineers led across four remote teams and four time zones</span>
            </div>
            <div class="metric">
              <strong>5-10M</strong>
              <span>weekly clicks handled by affiliate tracking platforms</span>
            </div>
            <div class="metric">
              <strong>10 mins</strong>
              <span>to build this website using Codex</span>
            </div>
          </div>
          <p class="positioning">
            <strong>Positioning:</strong> tech lead, senior TypeScript and PHP engineer, and engineering
            leader with devops architecture experience and the ability to build multi-region platforms.
          </p>
        </aside>
      </div>

      <section id="profile">
        <div class="site-shell">
          <div class="section-title">
            <h2>Engineer first. Manager when it matters.</h2>
            <p>
              My strongest roles sit between individual contribution and engineering management. I can design
              and build systems myself, but I can also stabilise teams, make delivery predictable, mentor
              engineers, and communicate clearly with product, finance, and executive stakeholders.
            </p>
          </div>

          <div class="pill-grid">
            <div class="pill">
              <strong>Modern product engineering</strong>
              <span>TypeScript, PHP, React, REST APIs, payments, subscriptions, and integrations.</span>
            </div>
            <div class="pill">
              <strong>Leadership with code credibility</strong>
              <span>Team structure, mentoring, hiring, delivery planning, one-to-ones, and technical direction.</span>
            </div>
            <div class="pill">
              <strong>Operational discipline</strong>
              <span>CI/CD, testing strategy, regulated change control, production support, Docker, Kubernetes, AWS, and multi-region architecture.</span>
            </div>
          </div>
        </div>
      </section>

      <section id="experience">
        <div class="site-shell">
          <div class="section-title">
            <h2>Recent work</h2>
            <p>
              A mix of hands-on software engineering, leadership in remote teams, platform modernisation, and
              production-grade delivery in commercial and regulated environments.
            </p>
          </div>

          <div class="timeline">
            <article class="role">
              <div>
                <h3>VP of Engineering · ClickTech</h3>
                <p class="role-meta">Nottingham, remote · Nov 2025 - Aug 2026</p>
              </div>
              <ul>
                <li>Led four remote teams while staying close to architecture and implementation.</li>
                <li>Rebuilt a central NestJS payments and subscriptions API with unified webhooks, endpoints, and a shared client library.</li>
                <li>Eliminated production outages within roughly three weeks, then removed release regressions through end-to-end testing and team training.</li>
                <li>Standardised AI-assisted development with guardrails, templates, review gates, and internal engineering standards.</li>
              </ul>
            </article>

            <article class="role">
              <div>
                <h3>Engineer III · AJ Bell</h3>
                <p class="role-meta">Manchester · Mar 2023 - Oct 2025</p>
              </div>
              <ul>
                <li>Developed customer-facing investment platform services across frontend and backend systems.</li>
                <li>Built and improved REST APIs, third-party integrations, and supporting services with reliability and maintainability in focus.</li>
                <li>Worked in a security- and stability-first financial services culture with rigorous review, testing, and change control.</li>
              </ul>
            </article>

            <article class="role">
              <div>
                <h3>Head of Development · Moreniche</h3>
                <p class="role-meta">Nottingham · Mar 2017 - Mar 2023</p>
              </div>
              <ul>
                <li>Set technical direction for affiliate interfaces, REST/API platforms, tracking servers, shops, devops, and design teams.</li>
                <li>Scaled the tracking platform from about 1M to 5-10M clicks per week at marketing peak.</li>
                <li>Supported $2-5M/year in affiliate revenue while improving reliability and operational control.</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section id="projects">
        <div class="site-shell">
          <div class="section-title">
            <h2>Personal projects</h2>
            <p>
              Current public repositories focus on AI-assisted delivery governance, controlled data access,
              and reusable application foundations. Yaup, Pane, and Latte are designed to work as a practical
              stack for safer agent-assisted software delivery.
            </p>
          </div>

          <div class="project-grid">
            {
              projects.map((project) => (
                <article class="project">
                  <div>
                    <p class="year">{project.year}</p>
                    <h3>{project.name}</h3>
                    <p><strong>{project.label}</strong></p>
                    <p>{project.body}</p>
                    <a class="project-link" href={project.href}>View repository</a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="skills">
        <div class="site-shell">
          <div class="section-title">
            <h2>Core skills</h2>
            <p>
              The technical base is broad, but the current focus is modern TypeScript product engineering,
              production reliability, and disciplined AI-assisted delivery.
            </p>
          </div>

          <div class="skills">
            <div class="skill-group">
              <h3>Backend</h3>
              <p>TypeScript, Node.js, NestJS, REST API design, payments, subscriptions, integrations, PHP, Laravel, Symfony, Zend.</p>
            </div>
            <div class="skill-group">
              <h3>Frontend</h3>
              <p>React, Vue, TypeScript, JavaScript, and legacy-to-modern product migrations.</p>
            </div>
            <div class="skill-group">
              <h3>Cloud & infrastructure</h3>
              <p>AWS, EKS, Vercel, Railway, Docker, Kubernetes, Linux, Bash, SQL, NoSQL, and CI/CD.</p>
            </div>
            <div class="skill-group">
              <h3>Leadership</h3>
              <p>Technical direction, mentoring, hiring, stakeholder communication, delivery planning, and AI workflow governance.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="contact">
        <div class="site-shell contact-band">
          <div>
            <p class="eyebrow">Engineering Leadership · Delivery Discipline · AI-assisted Workflows</p>
            <h2>Engineering judgment, code credibility, and management experience in one place.</h2>
          </div>
          <div class="contact-links">
            <a href="mailto:me@erme2.com">
              <span class="contact-icon" aria-hidden="true">@</span>
              <span>me@erme2.com</span>
            </a>
            <a href="https://github.com/erme2">
              <span class="contact-icon" aria-hidden="true">GH</span>
              <span>github.com/erme2</span>
            </a>
            <a href="https://linkedin.com/in/arduinodigiosia">
              <span class="contact-icon" aria-hidden="true">in</span>
              <span>linkedin.com/in/arduinodigiosia</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-shell footer">
      <span>Arduino Di Giosia · Tech lead and senior engineer · TypeScript, React, PHP</span>
    </footer>
  </body>
</html>
